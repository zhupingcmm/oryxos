<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.oryxos</groupId>
        <artifactId>oryxos-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>oryxos-cli</artifactId>
    <name>OryxOS CLI</name>
    <description>Picocli command-line entry + 12 sub-commands + ConfigLoader. init / status / chat / serve / gateway / profile / provider / tool / session.</description>

    <!-- Single source of truth for the CLI main class — referenced by
         maven-jar-plugin's <manifest><mainClass>, exec-maven-plugin's
         <mainClass>, and the spec's NFR-005. Any rename must update
         <cli.main.class> AND all reference sites in lockstep (CI lint
         safeguards against drift). -->
    <properties>
        <cli.main.class>io.oryxos.cli.OryxOsCli</cli.main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.oryxos</groupId>
            <artifactId>oryxos-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.oryxos</groupId>
            <artifactId>oryxos-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>io.oryxos</groupId>
            <artifactId>oryxos-tool</artifactId>
        </dependency>

        <dependency>
            <groupId>io.oryxos</groupId>
            <artifactId>oryxos-storage</artifactId>
        </dependency>

        <dependency>
            <groupId>io.oryxos</groupId>
            <artifactId>oryxos-channel-cli</artifactId>
        </dependency>

        <dependency>
            <groupId>io.oryxos</groupId>
            <artifactId>oryxos-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- WireMock for ChatCommandIT / ProviderListCommandTest (T003, T018, T030). -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Mockito for SessionListCommandTest (T032). -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${cli.main.class}</mainClass>
                        </manifest>
                        <manifestEntries>
                            <Implementation-Title>${project.name}</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Implementation-Vendor-Id>${project.groupId}</Implementation-Vendor-Id>
                            <Multi-Release>true</Multi-Release>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Shade into a fat jar so `java -jar oryxos-cli-*.jar` works end-to-end
                 (CLAUDE.md §4). Pre-existing infra gap inherited from 003-cli-commands;
                 surfaced by cli-smoke.sh when `java -jar` could not resolve picocli.
                 Transformers:
                 - ManifestResourceTransformer: keep the <mainClass> from maven-jar-plugin
                 - ServicesResourceTransformer: merge META-INF/services/* (Spring Factories etc.)
                 - AppendingTransformer: append multiline SPI files (e.g. META-INF/spring.factories)
                 Excludes: signed jars (none currently present; defensive for future deps),
                 and JDK-provided modules (handled by JDK 21 boot classpath). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <shadedClassifierName>shaded</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${cli.main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring.factories</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring/org.springframework.boot.autoconfigure.AutoConfiguration.imports</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring/aot.factories</resource>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Run the CLI directly: `mvn -pl oryxos-cli exec:java` -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${cli.main.class}</mainClass>
                </configuration>
            </plugin>

            <!-- Run *IT.java classes alongside *Test.java under `mvn test`.
                 The CLI does not yet wire maven-failsafe-plugin (Phase 5),
                 so we extend Surefire's default include pattern instead. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>